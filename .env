# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:root@localhost:5432/furniture_store
APP_DEBUG=true

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=7bb7bf43853c9e6aa3e9fe3394e755596ddecbdde506859937dc805f5566f6ee
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an app password for "Mail" — use that 16-char code below (no spaces)
GMAIL_USER=elmshelf12@gmail.com
GMAIL_APP_PASSWORD=adpm dqgg nzmg mbsl
EMAIL_FROM_NAME=Elmshelf Store
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ── reCAPTCHA v2 ─────────────────────────────────────────────────────────────
# Create a v2 "I'm not a robot" site at: https://www.google.com/recaptcha/admin/create
# Use the SECRET KEY here (site key goes in the frontend .env)
RECAPTCHA_SECRET_KEY=6LeeogUtAAAAABjdtP8Btwv9CZ4tghYA1xwMSk-h
RECAPTCHA_ENABLED=true

# ── Google OAuth ─────────────────────────────────────────────────────────────
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorised JS origins:     http://localhost:3000
# 4. Authorised redirect URIs:  http://localhost:3000
GOOGLE_CLIENT_ID=827162933941-ch04j40p1k00q8julhdoimsr72851lk5.apps.googleusercontent.com
# ── Stripe ────────────────────────────────────────────────────────────────────
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
MAX_VIDEO_FILE_SIZE=20971520

# ── CORS & Security ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
ENABLE_DOCS=false

# ── Rate Limiting & Account Lockout ───────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
